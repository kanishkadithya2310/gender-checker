secret_words = {
    "Ashwin":"Nerd",
    "Ragul":"Gossiper",
    "Ajay":"Capturer",
    "Aman":"Anna",
    "Gurumoorthy":"Sportsman",
    "Harsha":"Sleepyhead",
    "Ranganathan":"Mathematician",
    "Saffer":"Gymboy",
    "Shakel":"Footballer",
    "Aadhavan":"Topper",
    "Tharun":"Rebel",
    "Dinesh Baalaji":"Optimist",
    "Anirudh":"Athlete",
    "Koushik":"Leader"
}

name = (input("Enter your name: ").title().strip())
if name in secret_words:
    secret_word = secret_words[name]
    guess = ""
    guess_count = 0
    guess_limit = 3
    out_of_guess = False

    while guess != secret_word and not (out_of_guess):
        if guess_count < guess_limit:
            guess = input(f"Hi {name},Guess your personality: ").title().strip()
            guess_count += 1
            if guess != secret_word:
                guesses_left = guess_limit - guess_count
                print(f"Wrong! {guesses_left} guess(es) left")
        else:
            out_of_guess = True

    if out_of_guess:
        print("Out of guesses, You lose")
    else:
        print("Correct")
else:
    print("Sorry, You are not part of this game")
